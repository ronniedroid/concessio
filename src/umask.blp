using Gtk 4.0;
using Adw 1;

template $ConcessioUMask: Box {
    orientation: vertical;
    spacing: 24;

    Adw.Bin {
        Box {
            margin-top: 12;

            styles [
                "linked",
            ]

            DropDown input_type {
                model: StringList {
                    strings [
                        _("Umask"),
                        _("Files"),
                        _("Directories")
                        ,
                    ]
                };

                tooltip-text: _("Choose the value you know");

                accessibility {
                    label: _("Known value");
                    description: _("Choose whether to enter a umask, file permissions, or directory permissions.");
                }
            }

            Entry umask_entry {
                hexpand: true;
                placeholder-text: _("022");

                accessibility {
                    label: _("Umask value");
                    description: _("Enter an octal value from 000 to 777 for the selected input type.");
                }
            }

            Button {
                icon-name: "object-select-symbolic";
                tooltip-text: _("Apply value");
                clicked => $commit_umask_value();

                accessibility {
                    label: _("Apply value");
                }
            }
        }
    }

    ListBox {
        selection-mode: none;

        styles [
            "boxed-list",
        ]

        Adw.ActionRow {
            title: _("Umask");
            subtitle: _("Umask needed for these permissions");

            [prefix]
            MenuButton {
                icon-name: "dialog-information-symbolic";
                valign: center;
                tooltip-text: _("About umask");

                styles [
                    "flat",
                ]

                accessibility {
                    label: _("About umask");
                }

                popover: Popover {
                    Label {
                        label: _(
                            "A umask specifies which permissions are removed when new files and directories are created."
                        );
                        wrap: true;
                        max-width-chars: 32;
                        margin-top: 12;
                        margin-bottom: 12;
                        margin-start: 12;
                        margin-end: 12;
                    }
                };
            }

            [suffix]
            Label umask_target_label {
                valign: center;

                styles [
                    "monospace",
                    "title-3",
                ]
            }
        }

        Adw.ActionRow files_row {
            title: _("Files");
            subtitle: _("New files will be created with this permission");

            [prefix]
            MenuButton {
                icon-name: "dialog-information-symbolic";
                valign: center;
                tooltip-text: _("About file permissions");

                styles [
                    "flat",
                ]

                accessibility {
                    label: _("About file permissions");
                }

                popover: Popover {
                    Label {
                        label: _(
                            "New files start with permission 666. A umask can remove permissions, but cannot add execute permission."
                        );
                        wrap: true;
                        max-width-chars: 32;
                        margin-top: 12;
                        margin-bottom: 12;
                        margin-start: 12;
                        margin-end: 12;
                    }
                };
            }

            [suffix]
            Label files_target_label {
                valign: center;

                styles [
                    "monospace",
                    "title-3",
                ]
            }
        }

        Adw.ActionRow dirs_row {
            title: _("Directories");
            subtitle: _("New directories will be created with this permission");

            [prefix]
            MenuButton {
                icon-name: "dialog-information-symbolic";
                valign: center;
                tooltip-text: _("About directory permissions");

                styles [
                    "flat",
                ]

                accessibility {
                    label: _("About directory permissions");
                }

                popover: Popover {
                    Label {
                        label: _(
                            "New directories start with permission 777. A umask can remove read, write, and execute permissions."
                        );
                        wrap: true;
                        max-width-chars: 32;
                        margin-top: 12;
                        margin-bottom: 12;
                        margin-start: 12;
                        margin-end: 12;
                    }
                };
            }

            [suffix]
            Label dirs_target_label {
                valign: center;

                styles [
                    "monospace",
                    "title-3",
                ]
            }
        }
    }
}


