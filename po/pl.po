#: data/ui/BoxedList.blp:288 data/ui/HelpDialog.blp:298
msgid ""
"Executes the file with the permissions of the file owner, not the user "
"running it."
msgstr ""
"Wykonuje plik z uprawnieniami właściciela, zamiast użytkownika "
"uruchamiającego plik."

#: data/ui/BoxedList.blp:325
