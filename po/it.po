#: data/ui/BoxedList.blp:13 data/ui/HelpDialog.blp:116
msgid "User"
msgstr "Utente"

#: data/ui/BoxedList.blp:23 data/ui/BoxedList.blp:103 data/ui/BoxedList.blp:183
msgid "Read"
msgstr "Lettura"

#: data/ui/BoxedList.blp:26
msgid "User read permission"
msgstr "Permesso di lettura dell'utente"

#: data/ui/BoxedList.blp:41 data/ui/BoxedList.blp:121 data/ui/BoxedList.blp:201
msgid "Write"
msgstr "Scrittura"

#: data/ui/BoxedList.blp:44
msgid "User write permission"
msgstr "Permesso di scrittura dell'utente"

#: data/ui/BoxedList.blp:59 data/ui/BoxedList.blp:139 data/ui/BoxedList.blp:219
msgid "Execute"
msgstr "Eseguire"

#: data/ui/BoxedList.blp:62
msgid "User execute permission"
msgstr "Permesso di esecuzione dell'utente"

#: data/ui/BoxedList.blp:82
msgid "Set user ID SUID options"
msgstr "Imposta le opzioni SUID dell'ID utente"

#: data/ui/BoxedList.blp:93 data/ui/HelpDialog.blp:126
msgid "Group"
msgstr "Gruppo"

#: data/ui/BoxedList.blp:106
msgid "Group read permission"
msgstr "Permesso di lettura del gruppo"

#: data/ui/BoxedList.blp:124
msgid "Group write permission"
msgstr "Autorizzazione di scrittura del gruppo"

#: data/ui/BoxedList.blp:142
msgid "Group execute permission"
msgstr "Permesso di esecuzione del gruppo"

#: data/ui/BoxedList.blp:162
msgid "Set group ID SGID options"
msgstr "Imposta le opzioni SGID dell'ID gruppo"

#: data/ui/BoxedList.blp:173 data/ui/HelpDialog.blp:136
msgid "Others"
msgstr "Altri"

#: data/ui/BoxedList.blp:186
msgid "Other users read permission"
msgstr "Permessi di lettura di altri utenti"

#: data/ui/BoxedList.blp:204
msgid "Other users write permission"
msgstr "Permessi di scrittura di altri utenti"

#: data/ui/BoxedList.blp:222
msgid "Other users execute permission"
msgstr "Permessi di esecuzione di altri utenti"

#: data/ui/BoxedList.blp:242
msgid "Sticky bit options"
msgstr "Opzioni Sticky bit"

#: data/ui/BoxedList.blp:283
msgid "Set user ID SUID switch"
msgstr "Imposta cambio SUID dell'ID utente"

#: data/ui/BoxedList.blp:288 data/ui/HelpDialog.blp:298
msgid ""
"Executes the file with the permissions of the file owner, not the user "
"running it."
msgstr ""
"Esegue il file con i permessi del proprietario del file, non dell'utente che "
"lo sta eseguendo."

#: data/ui/BoxedList.blp:325
msgid "Set group ID SGID switch"
msgstr "Imposta cambio SGID dell'ID gruppo"

#: data/ui/BoxedList.blp:330 data/ui/HelpDialog.blp:303
msgid ""
"Executes the file with the permissions of the file's group, or ensures new "
"files in a directory inherit the group."
msgstr ""
"Esegue il file con i permessi del gruppo del file o assicura che i nuovi "
"file in una directory ereditino il gruppo."

#: data/ui/BoxedList.blp:367
msgid "Sticky bit switch"
msgstr "Cambia Sticky bit"

#: data/ui/BoxedList.blp:372 data/ui/HelpDialog.blp:308
msgid ""
"Allows only the file owner or directory owner to delete files in the "
"directory, even if others have write permissions. Only applies to "
"directories and has no effect on files."
msgstr ""
"Consente solo al proprietario del file o della directory di eliminare i file "
"nella directory, anche se altri hanno permessi di scrittura. Si applica solo "
"alle directory e non ha effetto sui file."

#: data/ui/Form.blp:14
msgid "Numeric"
msgstr "Numerico"

#: data/ui/Form.blp:32
msgid "Numeric permissions"
msgstr "Permessi numerici"

#: data/ui/Form.blp:33
msgid "Enter three or four octal digits, for example 0755"
msgstr "Inserisci tre o quattro cifre ottali, ad esempio 0755"

#: data/ui/Form.blp:39 data/ui/Form.blp:83
msgid "Copy value"
msgstr "Copia valore"

#: data/ui/Form.blp:43
msgid "Copy numeric value"
msgstr "Copia valore numerico"

#: data/ui/Form.blp:54
msgid "Symbolic"
msgstr "Simbolico"

#: data/ui/Form.blp:72
msgid "Symbolic permissions"
msgstr "Permessi simbolici"

#: data/ui/Form.blp:73
msgid ""
"Enter nine characters representing read, write, and execute permissions for "
"user, group, and others, for example rwxr-xr-x"
msgstr ""
"Inserisci nove caratteri che rappresentano i permessi di lettura, scrittura ed esecuzione per "
"utente, gruppo e altri, ad esempio rwxr-xr-x"

#: data/ui/Form.blp:87
msgid "Copy symbolic value"
msgstr "Copia valore simbolico"

#: data/ui/HelpDialog.blp:14 data/ui/Window.blp:159
msgid "Help"
msgstr "Aiuto"

#: data/ui/HelpDialog.blp:36
msgid "Table of Contents"
msgstr "Tabella dei contenuti"

#: data/ui/HelpDialog.blp:52 data/ui/HelpDialog.blp:86
msgid "Unix Permissions"
msgstr "Permessi Unix"

#: data/ui/HelpDialog.blp:63 data/ui/HelpDialog.blp:267
msgid "Special Permissions"
msgstr "Permessi speciali"

#: data/ui/HelpDialog.blp:74 data/ui/HelpDialog.blp:440 data/ui/Window.blp:132
msgid "Umask"
msgstr ""

#: data/ui/HelpDialog.blp:95
msgid ""
"The Unix permissions system is used to grant granulated access to file and "
"directories on a Unix-like operating system"
msgstr ""
"Il sistema di permessi Unix viene utilizzato per concedere un accesso "
"granulare a file e directory su un sistema operativo di tipo Unix"

#: data/ui/HelpDialog.blp:100
msgid "Permissions are granted to three groups:"
msgstr "I permessi vengono concessi a tre gruppi:"

#: data/ui/HelpDialog.blp:117
msgid "The owner of the file"
msgstr "Il proprietario del file"

#: data/ui/HelpDialog.blp:127
msgid "A group of users who share access to the file"
msgstr "Un gruppo di utenti che condividono l'accesso al file"

#: data/ui/HelpDialog.blp:137
msgid "All other users on the system"
msgstr "Tutti gli altri utenti del sistema"

#: data/ui/HelpDialog.blp:147
msgid "The types of permissions are:"
msgstr "I tipi di permessi sono:"

#: data/ui/HelpDialog.blp:163
msgid "Read (Symbolic: r, Numeric: 4)"
msgstr "Lettura (Simbolico: r, Numerico: 4)"

#: data/ui/HelpDialog.blp:164
msgid "Allows viewing the file's contents or listing a directory's contents"
msgstr ""
"Consente di visualizzare il contenuto del file o di elencare il contenuto di"
"una directory"

#: data/ui/HelpDialog.blp:173
msgid "Write (Symbolically: w, Numerically: 2)"
msgstr "Scrittura (Simbolico: w, Numericamente: 2)"

#: data/ui/HelpDialog.blp:174
msgid ""
"Allows modifying the file's contents or creating/deleting files within a "
"directory"
msgstr ""
"Consente di modificare il contenuto del file o di creare/eliminare file "
"all'interno di una directory"

#: data/ui/HelpDialog.blp:183
msgid "Execute (Symbolically: x, Numerically: 1)"
msgstr "Eseguire (Simbolicamente: x, Numericamente: 1)"

#: data/ui/HelpDialog.blp:184
msgid "Allows running the file as a program"
msgstr "Consente di eseguire il file come programma"

#: data/ui/HelpDialog.blp:195
msgid ""
"Permissions can either be represented symbolically or numerically. Symbolic "
"permissions are represented as a string of ten characters, and numeric is "
"represented by three numbers (octal notation) for Example:"
msgstr ""
"I permessi possono essere rappresentati simbolicamente o numericamente. I "
"permessi simbolici sono rappresentati come una stringa di dieci caratteri, "
"mentre quelli numerici sono rappresentati da tre numeri (notazione ottale) "
"per esempio:"

#: data/ui/HelpDialog.blp:200
msgid "Symbolic: -rwxr-xr--"
msgstr "Simbolico: -rwxr-xr--"

#: data/ui/HelpDialog.blp:210
msgid "Numeric: 754"
msgstr "Numerico: 754"

#: data/ui/HelpDialog.blp:226
msgid "First character, the file type"
msgstr "Primo carattere, il tipo di file"

#: data/ui/HelpDialog.blp:227
msgid "can either be '-' for file or 'd' for directory"
msgstr "può essere '-' per file o 'd' per directory"

#: data/ui/HelpDialog.blp:231
msgid "First three positions (after file type)"
msgstr "Prime tre posizioni (dopo il tipo di file)"

#: data/ui/HelpDialog.blp:232
msgid ""
"The read, write and execute permissions for the user, here we have 'rwx', "
"which translated to 4+2+1 and adds to 7"
msgstr ""
"I permessi di lettura, scrittura ed esecuzione per l'utente, qui abbiamo "
"'rwx', che tradotto è 4+2+1 e aggiunge 7"

#: data/ui/HelpDialog.blp:236
msgid "Second three positions"
msgstr "Seconde tre posizioni"

#: data/ui/HelpDialog.blp:237
msgid ""
"The read, write and execute permissions for the group, here we have 'r-x', "
"which translated to 4+0+1 and adds to 5"
msgstr ""
"I permessi di lettura, scrittura ed esecuzione per il gruppo, qui abbiamo 'r-"
"x', che tradotto è 4+0+1 e aggiunge 5"

#: data/ui/HelpDialog.blp:241
msgid "Last three positions"
msgstr "Ultime tre posizioni"

#: data/ui/HelpDialog.blp:242
msgid ""
"The read, write and execute permissions for other users, here we have 'r--', "
"which translated to 4+0+0 and adds to 4"
msgstr ""
"I permessi di lettura, scrittura ed esecuzione per gli altri utenti, qui "
"abbiamo 'r--', che tradotto è 4+0+0 e aggiunge 4"

#: data/ui/HelpDialog.blp:248 data/ui/HelpDialog.blp:520
msgid "Example command"
msgstr "Comando di esempio"

#: data/ui/HelpDialog.blp:257
msgid "chmod 754 (file name)"
msgstr "chmod 754 (nome file)"

#: data/ui/HelpDialog.blp:276
msgid ""
"Special permissions make up a fourth access level in addition to user, "
"group, and other, they allow for additional privileges over the standard "
"permission sets"
msgstr ""
"I permessi speciali costituiscono un quarto livello di accesso oltre a "
"utente, gruppo e altro, e consentono privilegi aggiuntivi rispetto ai set di "
"permessi standard"

#: data/ui/HelpDialog.blp:281
msgid "The three special permissions are:"
msgstr "I tre permessi speciali sono::"

#: data/ui/HelpDialog.blp:314
msgid "Special permissions can be represented symbolically or numerically."
msgstr ""
"I permessi speciali possono essere rappresentati simbolicamente o "
"numericamente."

#: data/ui/HelpDialog.blp:320
msgid "Numeric representation:"
msgstr "Rappresentazione numerica:"

#: data/ui/HelpDialog.blp:330
msgid ""
"They are denoted as an extra digit before the user, group and others "
"permissions. Can Either be 0, 4, 2, 1 or any combination of them."
msgstr ""
"Sono indicati come una cifra aggiuntiva prima dell'utente, del gruppo e "
"degli altri permessi. Possono essere 0, 4, 2, 1 o una qualsiasi combinazione "
"di essi."

#: data/ui/HelpDialog.blp:340
msgid "Symbolical representation:"
msgstr "Rappresentazione simbolica:"

#: data/ui/HelpDialog.blp:357
msgid "Goes where 'x' normally is for the user"
msgstr "Va dove normalmente si trova 'x' per l'utente"

#: data/ui/HelpDialog.blp:362
msgid "Goes where 'x' normally is for the group"
msgstr "Va dove normalmente c'è 'x' per il gruppo"

#: data/ui/HelpDialog.blp:367
msgid "Goes where 'x' normally is for others"
msgstr "Va dove normalmente c'è 'x' per gli altri"

#: data/ui/HelpDialog.blp:373
msgid "Symbolic: -rwsr-Sr-t"
msgstr "Simbolico: --rwsr-Sr-t"

#: data/ui/HelpDialog.blp:383
msgid "Numeric: 7745"
msgstr "Numerico: 7745"

#: data/ui/HelpDialog.blp:400
msgid ""
"Represented as '4' numerically. Symbolically, it is either 's' if the owner "
"has execute permissions or 'S' if not."
msgstr ""
"Rappresentato numericamente come '4'. Simbolicamente, è 's' se il "
"proprietario ha i permessi di esecuzione o 'S' in caso contrario."

#: data/ui/HelpDialog.blp:405
msgid ""
"Represented as '2' numerically. Symbolically, it is either 's' if the group "
"has execute permissions or 'S' if not."
msgstr ""
"Rappresentato come '2' numericamente. Simbolicamente, è 's' se il gruppo ha "
"permessi di esecuzione o 'S' in caso contrario."

#: data/ui/HelpDialog.blp:410
msgid ""
"Represented as '1' numerically. Symbolically, it is either 't' if the others "
"have execute permissions or 'T' if not."
msgstr ""
"Rappresentato come '1' numericamente. Simbolicamente, è 't' se gli altri "
"hanno permessi di esecuzione o 'T' se non li hanno."

#: data/ui/HelpDialog.blp:416
msgid "Example commands"
msgstr "Comandi di esempio"

#: data/ui/HelpDialog.blp:425
msgid "chmod 7745 (file name)"
msgstr "chmod 7745 (nome file)"

#: data/ui/HelpDialog.blp:435 data/ui/HelpDialog.blp:549
msgid "Further reading"
msgstr "Ulteriore lettura"

#: data/ui/HelpDialog.blp:449
msgid ""
"The umask (user file-creation mask) determines the default permissions for "
"new files and directories. It acts as a filter that 'masks out' specific "
"bits from the base permissions."
msgstr ""
"La umask (maschera di creazione file utente) determina i permessi predefiniti per "
"nuovi file e directory. Agisce come un filtro che "maschera" specifici "
"bit dai permessi di base."

#: data/ui/HelpDialog.blp:454
msgid "Typical base permissions:"
msgstr "Autorizzazioni di base tipiche:"

#: data/ui/HelpDialog.blp:470
msgid "Directories (Base: 777)"
msgstr "Directories (Base: 777)"

#: data/ui/HelpDialog.blp:471
msgid "Full read, write, and execute permissions by default"
msgstr "Permessi di lettura, scrittura ed esecuzione completi per impostazione predefinita"

#: data/ui/HelpDialog.blp:475
msgid "Files (Base: 666)"
msgstr "Files (Base: 666)"

#: data/ui/HelpDialog.blp:476
msgid "Read and write permissions by default; execute is excluded for security"
msgstr "Permessi di lettura e scrittura predefiniti; l'esecuzione è esclusa per motivi di sicurezza"

#: data/ui/HelpDialog.blp:482
msgid "Calculation logic:"
msgstr "Logica di calcolo:"

#: data/ui/HelpDialog.blp:492
msgid ""
"The final permission is calculated by taking the base and removing the bits "
"set in the umask."
msgstr ""
"Il permesso finale viene calcolato prendendo la base e rimuovendo i bit "
"impostati nell'umask."

#: data/ui/HelpDialog.blp:508
msgid "Umask 022"
msgstr "Umask 022"

#: data/ui/HelpDialog.blp:509
msgid ""
"Removes write access for group and others. (Result: 755 for dirs, 644 for "
"files)"
msgstr ""
"Rimuove l'accesso in scrittura per il gruppo e altri. (Risultato: 755 per le directory, 644 "
"per i file)"

#: data/ui/HelpDialog.blp:513
msgid "Umask 077"
msgstr "Umask 077"

#: data/ui/HelpDialog.blp:514
msgid ""
"Removes all access for group and others. (Result: 700 for dirs, 600 for "
"files)"
msgstr ""
"Rimuove tutti gli accessi per il gruppo e altri. (Risultato: 700 per le directory, 600 per "
"i file)"

#: data/ui/HelpDialog.blp:529
msgid "umask 022"
msgstr "umask 022"

#: data/ui/HelpDialog.blp:540
msgid ""
"Note: The umask command only lasts for the current session. You need to set "
"the command in your bashrc or equivalent to make it permanent."
msgstr ""
"Nota: il comando umask è valido solo per la sessione corrente. È necessario impostare "
"il comando nel proprio bashrc o in un file equivalente per renderlo permanente."

