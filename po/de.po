#: src/permissions.blp:190
msgid "Symbolic permissions"
msgstr "Symbolische Berechtigungen"

#: src/permissions.blp:192
msgid "Enter nine characters representing read, write, and execute permissions for user, group, and others, for example rwxr-xr-x"
msgstr "Gib neun Zeichen ein, die Lese-, Schreib- und Ausführungsrechte für Benutzer, Gruppe und andere darstellen, zum Beispiel rwxr-xr-x"

#: src/permissions.blp:206
msgid "Apply symbolic value"
msgstr "Symbolischen Wert anwenden"

#: src/permissions.blp:221 src/help-dialog.blp:116
msgid "User"
msgstr "Benutzer"

#: src/permissions.blp:230 src/permissions.blp:348 src/permissions.blp:466
msgid "Read"
msgstr "Lesen"

#: src/permissions.blp:233
msgid "User read permission"
msgstr "Leseberechtigung des Benutzers"

#: src/permissions.blp:247 src/permissions.blp:365 src/permissions.blp:483
msgid "Write"
msgstr "Schreiben"

#: src/permissions.blp:250
msgid "User write permission"
msgstr "Schreibberechtigung des Benutzers"

#: src/permissions.blp:264 src/permissions.blp:382 src/permissions.blp:500
msgid "Execute"
msgstr "Ausführen"

#: src/permissions.blp:267
msgid "User execute permission"
msgstr "Ausführungsberechtigung des Benutzers"

#: src/permissions.blp:286
msgid "Set user ID SUID options"
msgstr "Benutzer-ID-SUID-Optionen setzen"

#: src/permissions.blp:320
msgid "Set user ID SUID switch"
msgstr "Benutzer-ID-SUID-Schalter setzen"

#: src/permissions.blp:326 src/help-dialog.blp:298
msgid "Executes the file with the permissions of the file owner, not the user running it."
msgstr "Führt die Datei mit den Berechtigungen des Dateibesitzers aus, nicht des ausführenden Benutzers."

#: src/permissions.blp:339 src/help-dialog.blp:126
msgid "Group"
msgstr "Gruppe"

#: src/permissions.blp:351
msgid "Group read permission"
msgstr "Leseberechtigung der Gruppe"

#: src/permissions.blp:368
msgid "Group write permission"
msgstr "Schreibberechtigung der Gruppe"

#: src/permissions.blp:385
msgid "Group execute permission"
msgstr "Ausführungsberechtigung der Gruppe"

#: src/permissions.blp:404
msgid "Set group ID SGID options"
msgstr "Gruppen-ID-SGID-Optionen setzen"

#: src/permissions.blp:438
msgid "Set group ID SGID switch"
msgstr "Gruppen-ID-SGID-Schalter setzen"

#: src/permissions.blp:444 src/help-dialog.blp:303
msgid "Executes the file with the permissions of the file's group, or ensures new files in a directory inherit the group."
msgstr "Führt die Datei mit den Berechtigungen der Dateigruppe aus oder stellt sicher, dass neue Dateien in einem Verzeichnis die Gruppe erben."

#: src/permissions.blp:457 src/help-dialog.blp:136
msgid "Others"
msgstr "Andere"

#: src/permissions.blp:469
msgid "Other users read permission"
msgstr "Leseberechtigung für andere Benutzer"

#: src/permissions.blp:486
msgid "Other users write permission"
msgstr "Schreibberechtigung für andere Benutzer"

#: src/permissions.blp:503
msgid "Other users execute permission"
msgstr "Ausführungsberechtigung für andere Benutzer"

#: src/permissions.blp:522
msgid "Sticky bit options"
msgstr "Sticky-Bit-Optionen"

#: src/permissions.blp:556
msgid "Sticky bit switch"
msgstr "Sticky-Bit-Schalter"

#: src/permissions.blp:562 src/help-dialog.blp:308
msgid "Allows only the file owner or directory owner to delete files in the directory, even if others have write permissions. Only applies to directories and has no effect on files."
msgstr "Erlaubt nur dem Dateibesitzer oder Verzeichnisbesitzer, Dateien im Verzeichnis zu löschen, selbst wenn andere Schreibberechtigungen haben. Gilt nur für Verzeichnisse und hat keine Auswirkung auf Dateien."

#: src/help-dialog.blp:36
msgid "Table of Contents"
msgstr "Inhaltsverzeichnis"

#: src/help-dialog.blp:52 src/help-dialog.blp:86
msgid "Unix Permissions"
msgstr "Unix-Berechtigungen"

#: src/help-dialog.blp:63 src/help-dialog.blp:267
msgid "Special Permissions"
msgstr "Spezielle Berechtigungen"

#: src/help-dialog.blp:95
msgid "The Unix permissions system is used to grant granulated access to file and directories on a Unix-like operating system"
msgstr "Das Unix-Berechtigungssystem wird verwendet, um granulierten Zugriff auf Dateien und Verzeichnisse in einem Unix-ähnlichen Betriebssystem zu gewähren"

#: src/help-dialog.blp:100
msgid "Permissions are granted to three groups:"
msgstr "Berechtigungen werden drei Gruppen gewährt:"

#: src/help-dialog.blp:117
msgid "The owner of the file"
msgstr "Dem Besitzer der Datei"

#: src/help-dialog.blp:127
msgid "A group of users who share access to the file"
msgstr "Einer Gruppe von Benutzern, die den Zugriff auf die Datei teilen"

#: src/help-dialog.blp:137
msgid "All other users on the system"
msgstr "Allen anderen Benutzern im System"

#: src/help-dialog.blp:147
msgid "The types of permissions are:"
msgstr "Die Arten von Berechtigungen sind:"

#: src/help-dialog.blp:163
msgid "Read (Symbolic: r, Numeric: 4)"
msgstr "Lesen (Symbolisch: r, Numerisch: 4)"

#: src/help-dialog.blp:164
msgid "Allows viewing the file's contents or listing a directory's contents"
msgstr "Ermöglicht das Anzeigen des Inhalts der Datei oder das Auflisten des Inhalts eines Verzeichnisses"

#: src/help-dialog.blp:173
msgid "Write (Symbolically: w, Numerically: 2)"
msgstr "Schreiben (Symbolisch: w, Numerisch: 2)"

#: src/help-dialog.blp:174
msgid "Allows modifying the file's contents or creating/deleting files within a directory"
msgstr "Ermöglicht das Ändern des Inhalts der Datei oder das Erstellen/Löschen von Dateien innerhalb eines Verzeichnisses"

#: src/help-dialog.blp:183
msgid "Execute (Symbolically: x, Numerically: 1)"
msgstr "Ausführen (Symbolisch: x, Numerisch: 1)"

#: src/help-dialog.blp:184
msgid "Allows running the file as a program"
msgstr "Ermöglicht das Ausführen der Datei als Programm"

#: src/help-dialog.blp:195
msgid "Permissions can either be represented symbolically or numerically. Symbolic permissions are represented as a string of ten characters, and numeric is represented by three numbers (octal notation) for Example:"
msgstr "Berechtigungen können entweder symbolisch oder numerisch dargestellt werden. Symbolische Berechtigungen werden als Zeichenfolge von zehn Zeichen dargestellt, und numerische werden durch drei Zahlen (oktale Notation) zum Beispiel:"

#: src/help-dialog.blp:200
msgid "Symbolic: -rwxr-xr--"
msgstr "Symbolisch: -rwxr-xr--"

#: src/help-dialog.blp:210
msgid "Numeric: 754"
msgstr "Numerisch: 754"

#: src/help-dialog.blp:226
msgid "First character, the file type"
msgstr "Erstes Zeichen, der Dateityp"

#: src/help-dialog.blp:227
msgid "can either be '-' for file or 'd' for directory"
msgstr "kann entweder '-' für eine Datei oder 'd' für ein Verzeichnis sein"

#: src/help-dialog.blp:231
msgid "First three positions (after file type)"
msgstr "Erste drei Positionen (nach dem Dateityp)"

#: src/help-dialog.blp:232
msgid "The read, write and execute permissions for the user, here we have 'rwx', which translated to 4+2+1 and adds to 7"
msgstr "Die Lese-, Schreib- und Ausführungsberechtigungen für den Benutzer, hier haben wir 'rwx', was 4+2+1 ergibt und sich auf 7 addiert"

#: src/help-dialog.blp:236
msgid "Second three positions"
msgstr "Zweite drei Positionen"

#: src/help-dialog.blp:237
msgid "The read, write and execute permissions for the group, here we have 'r-x', which translated to 4+0+1 and adds to 5"
msgstr "Die Lese-, Schreib- und Ausführungsberechtigungen für die Gruppe, hier haben wir 'r-x', was 4+0+1 ergibt und sich auf 5 addiert"

#: src/help-dialog.blp:241
msgid "Last three positions"
msgstr "Letzte drei Positionen"

#: src/help-dialog.blp:242
msgid "The read, write and execute permissions for other users, here we have 'r--', which translated to 4+0+0 and adds to 4"
msgstr "Die Lese-, Schreib- und Ausführungsberechtigungen für andere Benutzer, hier haben wir 'r--', was 4+0+0 ergibt und sich auf 4 addiert"

#: src/help-dialog.blp:248 src/help-dialog.blp:520
msgid "Example command"
msgstr "Beispielbefehl"

#: src/help-dialog.blp:257
msgid "chmod 754 (file name)"
msgstr "chmod 754 (Dateiname)"

#: src/help-dialog.blp:276
msgid "Special permissions make up a fourth access level in addition to user, group, and other, they allow for additional privileges over the standard permission sets"
msgstr "Sonderberechtigungen bilden eine vierte Zugriffsebene zusätzlich zu Benutzer, Gruppe und anderen. Sie ermöglichen zusätzliche Privilegien gegenüber den standardmäßigen Berechtigungssätzen"

#: src/help-dialog.blp:281
msgid "The three special permissions are:"
msgstr "Die drei speziellen Berechtigungen sind:"

#: src/help-dialog.blp:314
msgid "Special permissions can be represented symbolically or numerically."
msgstr "Spezielle Berechtigungen können symbolisch oder numerisch dargestellt werden."

#: src/help-dialog.blp:320
msgid "Numeric representation:"
msgstr "Numerische Darstellung:"

#: src/help-dialog.blp:330
msgid "They are denoted as an extra digit before the user, group and others permissions. Can Either be 0, 4, 2, 1 or any combination of them."
msgstr "Sie werden als zusätzliche Ziffer vor den Berechtigungen für Benutzer, Gruppe und Andere angegeben. Kann entweder 0, 4, 2, 1 oder eine beliebige Kombination davon sein."

#: src/help-dialog.blp:340
msgid "Symbolical representation:"
msgstr "Symbolische Darstellung:"

#: src/help-dialog.blp:357
msgid "Goes where 'x' normally is for the user"
msgstr "Steht dort, wo normalerweise 'x' für den Benutzer steht"

#: src/help-dialog.blp:362
msgid "Goes where 'x' normally is for the group"
msgstr "Steht dort, wo normalerweise 'x' für die Gruppe steht"

#: src/help-dialog.blp:367
msgid "Goes where 'x' normally is for others"
msgstr "Steht dort, wo normalerweise 'x' für die Anderen steht"

#: src/help-dialog.blp:373
msgid "Symbolic: -rwsr-Sr-t"
msgstr "Symbolisch: -rwsr-Sr-t"

#: src/help-dialog.blp:383
msgid "Numeric: 7745"
msgstr "Numerisch: 7745"

#: src/help-dialog.blp:400
msgid "Represented as '4' numerically. Symbolically, it is either 's' if the owner has execute permissions or 'S' if not."
msgstr "Numerisch als '4' dargestellt. Symbolisch ist es entweder 's', wenn der Besitzer Ausführungsberechtigungen hat, oder 'S', wenn nicht."

#: src/help-dialog.blp:405
msgid "Represented as '2' numerically. Symbolically, it is either 's' if the group has execute permissions or 'S' if not."
msgstr "Numerisch als '2' dargestellt. Symbolisch ist es entweder 's', wenn die Gruppe Ausführungsberechtigungen hat, oder 'S', wenn nicht."

#: src/help-dialog.blp:410
msgid "Represented as '1' numerically. Symbolically, it is either 't' if the others have execute permissions or 'T' if not."
msgstr "Numerisch als '1' dargestellt. Symbolisch ist es entweder 't', wenn die Anderen Ausführungsberechtigungen haben, oder 'T', wenn nicht."

#: src/help-dialog.blp:416
msgid "Example commands"
msgstr "Beispielbefehle"

#: src/help-dialog.blp:425
msgid "chmod 7745 (file name)"
msgstr "chmod 7745 (Dateiname)"

#: src/help-dialog.blp:435 src/help-dialog.blp:549
msgid "Further reading"
msgstr "Weiterführende Literatur"

#: src/help-dialog.blp:449
msgid "The umask (user file-creation mask) determines the default permissions for new files and directories. It acts as a filter that 'masks out' specific bits from the base permissions."
msgstr "Die Umask (Benutzer-Dateierstellungsmaske) bestimmt die Standardberechtigungen für neue Dateien und Verzeichnisse. Sie fungiert als Filter, der bestimmte Bits aus den Basisberechtigungen 'ausblendet'."

#: src/help-dialog.blp:454
msgid "Typical base permissions:"
msgstr "Typische Basisberechtigungen:"

#: src/help-dialog.blp:470
msgid "Directories (Base: 777)"
msgstr "Verzeichnisse (Basis: 777)"

#: src/help-dialog.blp:471
msgid "Full read, write, and execute permissions by default"
msgstr "Standardmäßig volle Lese-, Schreib- und Ausführungsberechtigungen"

#: src/help-dialog.blp:475
msgid "Files (Base: 666)"
msgstr "Dateien (Basis: 666)"

#: src/help-dialog.blp:476
msgid "Read and write permissions by default; execute is excluded for security"
msgstr "Standardmäßig Lese- und Schreibberechtigungen; die Ausführung ist aus Sicherheitsgründen ausgeschlossen"

#: src/help-dialog.blp:482
msgid "Calculation logic:"
msgstr "Berechnungslogik:"

#: src/help-dialog.blp:492
msgid "The final permission is calculated by taking the base and removing the bits set in the umask."
msgstr "Die endgültige Berechtigung wird berechnet, indem von der Basis ausgegangen wird und die in der Umask gesetzten Bits entfernt werden."

#: src/help-dialog.blp:508
msgid "Umask 022"
msgstr "Umask 022"

#: src/help-dialog.blp:509
msgid "Removes write access for group and others. (Result: 755 for dirs, 644 for files)"
msgstr "Entfernt den Schreibzugriff für Gruppe und Andere. (Ergebnis: 755 für Verzeichnisse, 644 für Dateien)"

#: src/help-dialog.blp:513
msgid "Umask 077"
msgstr "Umask 077"

#: src/help-dialog.blp:514
msgid "Removes all access for group and others. (Result: 700 for dirs, 600 for files)"
msgstr "Entfernt sämtlichen Zugriff für Gruppe und Andere. (Ergebnis: 700 für Verzeichnisse, 600 für Dateien)"

#: src/help-dialog.blp:529
msgid "umask 022"
msgstr "umask 022"

#: src/help-dialog.blp:540
msgid "Note: The umask command only lasts for the current session. You need to set the command in your bashrc or equivalent to make it permanent."
msgstr "Hinweis: Der Befehl umask gilt nur für die aktuelle Sitzung. Sie müssen den Befehl in Ihrer bashrc oder einer ähnlichen Datei festlegen, um ihn dauerhaft zu machen."

#: src/umask.blp:25 src/umask.blp:28
msgid "The umask determines the default permissions removed from new files and directories."
msgstr "Umask bestimmt die Standardberechtigungen, die von neuen Dateien und Verzeichnissen entfernt werden."

#: src/umask.blp:44
msgid "Copy umask value"
msgstr "Umask-Wert kopieren"

#: src/umask.blp:53
msgid "Umask value"
msgstr "Umask-Wert"

#: src/umask.blp:54
msgid "Enter three octal digits for the umask value"
msgstr "Geben Sie drei oktale Ziffern für den Umask-Wert ein"

#: src/umask.blp:64
msgid "Apply umask value"
msgstr "Umask-Wert anwenden"

#: src/umask.blp:78
msgid "Files"
msgstr "Dateien"

#: src/umask.blp:79
msgid "New files will be created with this permission"
msgstr "Neue Dateien werden mit dieser Berechtigung erstellt"

#: src/umask.blp:93
msgid "Directories"
msgstr "Verzeichnisse"

#: src/umask.blp:94
msgid "New directories will be created with this permission"
msgstr "Neue Verzeichnisse werden mit dieser Berechtigung erstellt"
