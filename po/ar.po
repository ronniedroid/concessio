#: src/permissions.blp:25 src/permissions.blp:33
msgid "Open File"
msgstr "فتح الملف"

#: src/permissions.blp:38 src/permissions.blp:47
msgid "Open a file to view its permissions"
msgstr "افتح ملفًا لعرض صلاحياته"

#: src/permissions.blp:54 src/permissions.blp:59
msgid "Open a file"
msgstr "فتح ملف"

#: src/permissions.blp:105 src/permissions.blp:110
msgid "Open a different file"
msgstr "افتح ملفًا مختلفًا"

#: src/permissions.blp:116 src/permissions.blp:121
msgid "Close file"
msgstr "إغلاق الملف"

#: src/permissions.blp:127
msgid "Apply permission changes"
msgstr "تطبيق تغييرات الصلاحيات"

#: src/permissions.blp:136
msgid "Apply permission changes to file"
msgstr "تطبيق تغييرات الصلاحيات على الملف"

#: src/permissions.blp:153
msgid "Numeric"
msgstr "رقمي"

#: src/permissions.blp:168 src/permissions.blp:219
msgid "Copy value"
msgstr "نسخ القيمة"

#: src/permissions.blp:172
msgid "Copy numeric value"
msgstr "نسخ القيمة الرقمية"

#: src/permissions.blp:181
msgid "Numeric permissions"
msgstr "صلاحيات رقمية"

#: src/permissions.blp:182
msgid "Enter three or four octal digits, for example 0755"
msgstr "أدخل ثلاثة أو أربعة أرقام ثمانية، على سبيل المثال 0755"

#: src/permissions.blp:188 src/permissions.blp:245 src/umask.blp:46
#: src/umask.blp:50
msgid "Apply value"
msgstr "تطبيق القيمة"

#: src/permissions.blp:192
msgid "Apply numeric value"
msgstr "تطبيق القيمة الرقمية"

#: src/permissions.blp:204
msgid "Symbolic"
msgstr "رمزي"

#: src/permissions.blp:223
msgid "Copy symbolic value"
msgstr "نسخ القيمة الرمزية"

#: src/permissions.blp:232
msgid "Symbolic permissions"
msgstr "صلاحيات رمزية"

#: src/permissions.blp:234
msgid ""
"Enter nine characters representing read, write, and execute permissions for "
"user, group, and others, for example rwxr-xr-x"
msgstr ""
"أدخل تسعة أحرف تمثل صلاحيات القراءة والكتابة والتنفيذ للمالك والمجموعة "
"والآخرين، على سبيل المثال rwxr-xr-x"

#: src/permissions.blp:249
msgid "Apply symbolic value"
msgstr "تطبيق القيمة الرمزية"

#: src/permissions.blp:264 src/help-dialog.blp:148
msgid "User"
msgstr "المستخدم"

#: src/permissions.blp:273 src/permissions.blp:391 src/permissions.blp:509
msgid "Read"
msgstr "قراءة"

#: src/permissions.blp:276
msgid "User read permission"
msgstr "صلاحيات القراءة للمستخدم"

#: src/permissions.blp:290 src/permissions.blp:408 src/permissions.blp:526
msgid "Write"
msgstr "كتابة"

#: src/permissions.blp:293
msgid "User write permission"
msgstr "صلاحيات الكتابة للمستخدم"

#: src/permissions.blp:307 src/permissions.blp:425 src/permissions.blp:543
msgid "Execute"
msgstr "تنفيذ"

#: src/permissions.blp:310
msgid "User execute permission"
msgstr "صلاحيات التنفيذ للمستخدم"

#: src/permissions.blp:329
msgid "Set user ID SUID options"
msgstr "خيارات تعيين معرف المستخدم (SUID)"

#: src/permissions.blp:363
msgid "Set user ID SUID switch"
msgstr "مفتاح تفعيل تعيين معرف المستخدم (SUID)"

#: src/permissions.blp:369 src/help-dialog.blp:392
msgid ""
"Executes the file with the permissions of the file owner, not the user "
"running it."
msgstr ""
"يقوم بتنفيذ الملف بصلاحيات مالك الملف، وليس المستخدم الذي يقوم بتشغيله."

#: src/permissions.blp:382 src/help-dialog.blp:160
msgid "Group"
msgstr "المجموعة"

#: src/permissions.blp:394
msgid "Group read permission"
msgstr "صلاحيات القراءة للمجموعة"

#: src/permissions.blp:411
msgid "Group write permission"
msgstr "صلاحيات الكتابة للمجموعة"

#: src/permissions.blp:428
msgid "Group execute permission"
msgstr "صلاحيات التنفيذ للمجموعة"

#: src/permissions.blp:447
msgid "Set group ID SGID options"
msgstr "خيارات تعيين معرف المجموعة (SGID)"

#: src/permissions.blp:481
msgid "Set group ID SGID switch"
msgstr "مفتاح تفعيل تعيين معرف المجموعة (SGID)"

#: src/permissions.blp:487 src/help-dialog.blp:400
msgid ""
"Executes the file with the permissions of the file's group, or ensures new "
"files in a directory inherit the group."
msgstr ""
"يقوم بتنفيذ الملف بصلاحيات المجموعة، أو يضمن أن الملفات الجديدة في الدليل "
"ترث نفس المجموعة."

#: src/permissions.blp:500 src/help-dialog.blp:172
msgid "Others"
msgstr "الآخرون"

#: src/permissions.blp:512
msgid "Other users read permission"
msgstr "صلاحيات القراءة للمستخدمين الآخرين"

#: src/permissions.blp:529
msgid "Other users write permission"
msgstr "صلاحيات الكتابة للمستخدمين الآخرين"

#: src/permissions.blp:546
msgid "Other users execute permission"
msgstr "صلاحيات التنفيذ للمستخدمين الآخرين"

#: src/permissions.blp:565
msgid "Sticky bit options"
msgstr "خيارات البت اللاصق"

#: src/permissions.blp:599
msgid "Sticky bit switch"
msgstr "مفتاح تفعيل البت اللاصق"

#: src/permissions.blp:605 src/help-dialog.blp:408
msgid ""
"Allows only the file owner or directory owner to delete files in the "
"directory, even if others have write permissions. Only applies to "
"directories and has no effect on files."
msgstr ""
"يسمح فقط لمالك الملف أو مالك الدليل بحذف الملفات الموجودة في الدليل، حتى لو "
"كان لدى الآخرين أذونات الكتابة. ينطبق فقط على الدلائل وليس له تأثير على "
"الملفات."

#: src/help-dialog.blp:44
msgid "Table of Contents"
msgstr "جدول المحتويات"

#: src/help-dialog.blp:61 src/help-dialog.blp:107
msgid "Unix Permissions"
msgstr "صلاحيات يونكس"

#: src/help-dialog.blp:74 src/help-dialog.blp:349
msgid "Special Permissions"
msgstr "الصلاحيات الخاصة"

#: src/help-dialog.blp:87 src/help-dialog.blp:596
msgid "umask"
msgstr "قناع المستخدم"

#: src/help-dialog.blp:118
msgid ""
"The Unix permissions system is used to grant granulated access to file and "
"directories on a Unix-like operating system"
msgstr ""
"يُستخدم نظام صلاحيات يونكس لمنح الوصول المجزأ إلى الملفات والمجلدات على نظام "
"تشغيل مشابه ليونكس"

#: src/help-dialog.blp:131
msgid "Permissions are granted to three groups:"
msgstr "يتم منح الصلاحيات إلى ثلاث مجموعات:"

#: src/help-dialog.blp:149
msgid "The owner of the file"
msgstr "مالك الملف"

#: src/help-dialog.blp:161
msgid "A group of users who share access to the file"
msgstr "مجموعة من المستخدمين الذين يشاركون في الوصول إلى الملف"

#: src/help-dialog.blp:173
msgid "All other users on the system"
msgstr "جميع المستخدمين الآخرين على النظام"

#: src/help-dialog.blp:191
msgid "The types of permissions are:"
msgstr "أنواع الصلاحيات هي:"

#: src/help-dialog.blp:208
msgid "Read (Symbolic: r, Numeric: 4)"
msgstr "قراءة (رمزي: r، رقمي: 4)"

#: src/help-dialog.blp:209
msgid "Allows viewing the file's contents or listing a directory's contents"
msgstr "يسمح بعرض محتويات الملف أو سرد محتويات المجلد"

#: src/help-dialog.blp:220
msgid "Write (Symbolically: w, Numerically: 2)"
msgstr "كتابة (رمزي: w، رقمي: 2)"

#: src/help-dialog.blp:222
msgid ""
"Allows modifying the file's contents or creating/deleting files within a "
"directory"
msgstr "يسمح بتعديل محتويات الملف أو إنشاء/حذف الملفات داخل المجلد"

#: src/help-dialog.blp:234
msgid "Execute (Symbolically: x, Numerically: 1)"
msgstr "تنفيذ (رمزي: x، رقمي: 1)"

#: src/help-dialog.blp:235
msgid "Allows running the file as a program"
msgstr "يسمح بتشغيل الملف كبرنامج"

#: src/help-dialog.blp:249
msgid ""
"Permissions can either be represented symbolically or numerically. Symbolic "
"permissions are represented as a string of ten characters, and numeric is "
"represented by three numbers (octal notation) for Example:"
msgstr ""
"يمكن تمثيل الصلاحيات إما بشكل رمزي أو رقمي. يتم تمثيل الصلاحيات الرمزية "
"كسلسلة من عشرة أحرف، بينما يتم تمثيل الصلاحيات الرقمية بثلاثة أرقام (ترميز "
"ثماني) على سبيل المثال:"

#: src/help-dialog.blp:256
msgid "Symbolic: -rwxr-xr--"
msgstr "رمزي: -rwxr-xr--"

#: src/help-dialog.blp:267
msgid "Numeric: 754"
msgstr "رقمي: 754"

#: src/help-dialog.blp:284
msgid "First character, the file type"
msgstr "الحرف الأول: نوع الملف"

#: src/help-dialog.blp:285
msgid "can either be '-' for file or 'd' for directory"
msgstr "يمكن أن يكون '-' للملف أو 'd' للمجلد"

#: src/help-dialog.blp:290
msgid "First three positions (after file type)"
msgstr "المواضع الثلاثة الأولى (بعد نوع الملف)"

#: src/help-dialog.blp:292
msgid ""
"The read, write and execute permissions for the user, here we have 'rwx', "
"which translated to 4+2+1 and adds to 7"
msgstr ""
"صلاحيات القراءة والكتابة والتنفيذ للمستخدم، هنا لدينا 'rwx'، والتي تترجم إلى "
"4+2+1 وتساوي 7"

#: src/help-dialog.blp:298
msgid "Second three positions"
msgstr "المواضع الثلاثة الثانية"

#: src/help-dialog.blp:300
msgid ""
"The read, write and execute permissions for the group, here we have 'r-x', "
"which translated to 4+0+1 and adds to 5"
msgstr ""
"صلاحيات القراءة والكتابة والتنفيذ للمجموعة، هنا لدينا 'r-x'، والتي تترجم إلى "
"4+0+1 وتساوي 5"

#: src/help-dialog.blp:306
msgid "Last three positions"
msgstr "المواضع الثلاثة الأخيرة"

#: src/help-dialog.blp:308
msgid ""
"The read, write and execute permissions for other users, here we have 'r--', "
"which translated to 4+0+0 and adds to 4"
msgstr ""
"صلاحيات القراءة والكتابة والتنفيذ للمستخدمين الآخرين، هنا لدينا 'r--'، والتي "
"تترجم إلى 4+0+0 وتساوي 4"

#: src/help-dialog.blp:322 src/help-dialog.blp:707
msgid "Example command"
msgstr "أمر نموذجي"

#: src/help-dialog.blp:360
msgid ""
"Special permissions make up a fourth access level in addition to user, "
"group, and other, they allow for additional privileges over the standard "
"permission sets"
msgstr ""
"تشكل الصلاحيات الخاصة مستوى وصول رابعًا بالإضافة إلى المستخدم والمجموعة "
"والآخرين، فهي تسمح بامتيازات إضافية على مجموعات الصلاحيات القياسية"

#: src/help-dialog.blp:373
msgid "The three special permissions are:"
msgstr "الصلاحيات الخاصة الثلاثة هي:"

#: src/help-dialog.blp:416
msgid "Special permissions can be represented symbolically or numerically."
msgstr "يمكن تمثيل الصلاحيات الخاصة رمزيًا أو رقميًا."

#: src/help-dialog.blp:429
msgid "Numeric representation:"
msgstr "التمثيل الرقمي:"

#: src/help-dialog.blp:441
msgid ""
"They are denoted as an extra digit before the user, group and others "
"permissions. Can Either be 0, 4, 2, 1 or any combination of them."
msgstr ""
"يتم الإشارة إليها كرقم إضافي قبل صلاحيات المستخدم والمجموعة والآخرين. يمكن "
"أن تكون إما 0 أو 4 أو 2 أو 1 أو أي تركيبة منها."

#: src/help-dialog.blp:459
msgid "Symbolical representation:"
msgstr "التمثيل الرمزي:"

#: src/help-dialog.blp:477
msgid "Goes where 'x' normally is for the user"
msgstr "يقع في المكان الذي يوجد فيه 'x' عادةً للمستخدم"

#: src/help-dialog.blp:483
msgid "Goes where 'x' normally is for the group"
msgstr "يقع في المكان الذي يوجد فيه 'x' عادةً للمجموعة"

#: src/help-dialog.blp:489
msgid "Goes where 'x' normally is for others"
msgstr "يقع في المكان الذي يوجد فيه 'x' عادةً للآخرين"

#: src/help-dialog.blp:496
msgid "Symbolic: -rwsr-Sr-t"
msgstr "رمزي: -rwsr-Sr-t"

#: src/help-dialog.blp:507
msgid "Numeric: 7745"
msgstr "رقمي: 7745"

#: src/help-dialog.blp:526
msgid ""
"Represented as '4' numerically. Symbolically, it is either 's' if the owner "
"has execute permissions or 'S' if not."
msgstr ""
"يتم تمثيله ب \"4\" رقميا. ورمزيا، يكون \"s\" إذا كان المالك لديه صلاحيات "
"التنفيذ أو \"S\" إذا لم يكن لديه صلاحيات التنفيذ."

#: src/help-dialog.blp:534
msgid ""
"Represented as '2' numerically. Symbolically, it is either 's' if the group "
"has execute permissions or 'S' if not."
msgstr ""
"يتم تمثيله ب \"2\" رقميا. ورمزيا \"s\" إذا كانت المجموعة لديها صلاحيات "
"التنفيذ أو \"S\" إذا لم يكن لديها صلاحيات التنفيذ."

#: src/help-dialog.blp:542
msgid ""
"Represented as '1' numerically. Symbolically, it is either 't' if the others "
"have execute permissions or 'T' if not."
msgstr ""
"يتم تمثيله ب \"1\" رقميا. ورمزيا \"t\" إذا كان الآخرون لديهم صلاحيات التنفيذ "
"أو \"T\" إذا لم يكن لديهم صلاحيات التنفيذ."

#: src/help-dialog.blp:556
msgid "Example commands"
msgstr "أوامر نموذجية"

#: src/help-dialog.blp:580
msgid "Further reading about special permissions"
msgstr "قراءة إضافية عن الصلاحيات الخاصة"

#: src/help-dialog.blp:607
msgid ""
"The umask (user file-creation mask) determines the default permissions for "
"new files and directories. It acts as a filter that 'masks out' specific "
"bits from the base permissions."
msgstr ""
"يحدد قناع مستخدم إنشاء الملفات (umask) الأذونات الافتراضية للملفات والمجلدات "
"الجديدة. يعمل بمثابة مرشح يقوم بحجب أجزاء معينة من الأذونات الأساسية."

#: src/help-dialog.blp:620
msgid "Typical base permissions:"
msgstr "الأذونات الأساسية النموذجية:"

#: src/help-dialog.blp:637
msgid "Directories (Base: 777)"
msgstr "المجلدات (الأساس: 777)"

#: src/help-dialog.blp:638
msgid "Full read, write, and execute permissions by default"
msgstr "صلاحيات القراءة والكتابة والتنفيذ الكاملة افتراضيًا"

#: src/help-dialog.blp:643
msgid "Files (Base: 666)"
msgstr "الملفات (الأساس: 666)"

#: src/help-dialog.blp:644
msgid "Read and write permissions by default; execute is excluded for security"
msgstr "صلاحيات القراءة والكتابة افتراضيًا؛ ويُستثنى التنفيذ لأسباب أمنية"

#: src/help-dialog.blp:657
msgid "Calculation logic:"
msgstr "منطق الحساب:"

#: src/help-dialog.blp:669
msgid ""
"The final permission is calculated by taking the base and removing the bits "
"set in the umask."
msgstr ""
"يتم حساب الصلاحية النهائية بأخذ الأساس وإزالة البتات المحددة في قناع "
"المستخدم."

#: src/help-dialog.blp:687
msgid "umask 022"
msgstr "قناع المستخدم 022"

#: src/help-dialog.blp:688
msgid ""
"Removes write access for group and others. (Result: 755 for dirs, 644 for "
"files)"
msgstr ""
"يزيل صلاحية الكتابة للمجموعة والآخرين. (النتيجة: 755 للمجلدات، 644 للملفات)"

#: src/help-dialog.blp:693
msgid "umask 077"
msgstr "قناع المستخدم 077"

#: src/help-dialog.blp:694
msgid ""
"Removes all access for group and others. (Result: 700 for dirs, 600 for "
"files)"
msgstr ""
"يزيل جميع صلاحيات الوصول للمجموعة والآخرين. (النتيجة: 700 للمجلدات، 600 "
"للملفات)"

#: src/help-dialog.blp:730
msgid ""
"Note: The umask command only lasts for the current session. You need to set "
"the command in your bashrc or equivalent to make it permanent."
msgstr ""
"ملاحظة: أمر umask يستمر فقط للجلسة الحالية. تحتاج إلى تعيين الأمر في ملف "
"bashrc أو ما يعادله لجعله دائمًا."

#: src/help-dialog.blp:744
msgid "Further reading about umask"
msgstr "قراءة إضافية عن قناع المستخدم"

#: src/umask.vala:75
msgid "File permissions"
msgstr "صلاحيات الملفات"

#: src/umask.vala:80
msgid "Directory permissions"
msgstr "صلاحيات المجلدات"

#: src/umask.vala:85 src/umask.blp:39
msgid "Umask value"
msgstr "قيمة قناع المستخدم"

#: src/umask.vala:98
msgid "Enter an octal value from 000 to 777."
msgstr "أدخل قيمة ثُمانية من 000 إلى 777."

#: src/umask.vala:105
msgid "A umask cannot add execute permission to new files."
msgstr "لا يمكن لقناع المستخدم إضافة صلاحية التنفيذ إلى الملفات الجديدة."

#: src/umask.blp:20 src/umask.blp:108
msgid "Files"
msgstr "الملفات"

#: src/umask.blp:21 src/umask.blp:152
msgid "Directories"
msgstr "المجلدات"

#: src/umask.blp:26
msgid "Choose the value you know"
msgstr "اختر القيمة التي تعرفها"

#: src/umask.blp:29
msgid "Known value"
msgstr "القيمة المعروفة"

#: src/umask.blp:30
msgid ""
"Choose whether to enter a umask, file permissions, or directory permissions."
msgstr ""
"اختر ما إذا كنت تريد إدخال قناع مستخدم أو صلاحيات ملفات أو صلاحيات مجلدات."

#: src/umask.blp:40
msgid "Enter an octal value from 000 to 777 for the selected input type."
msgstr "أدخل قيمة ثُمانية من 000 إلى 777 لنوع الإدخال المحدد."

#: src/umask.blp:65
msgid "Umask needed for these permissions"
msgstr "قناع المستخدم اللازم لهذه الصلاحيات"

#: src/umask.blp:71 src/umask.blp:78
msgid "About umask"
msgstr "حول قناع المستخدم"

#: src/umask.blp:84
msgid ""
"A umask specifies which permissions are removed when new files and "
"directories are created."
msgstr ""
"يحدد قناع المستخدم صلاحيات الوصول الافتراضية التي تتم إزالتها من الملفات "
"والمجلدات الجديدة."

#: src/umask.blp:109
msgid "New files will be created with this permission"
msgstr "سيتم إنشاء الملفات الجديدة بهذه الصلاحيات"

#: src/umask.blp:115 src/umask.blp:122
msgid "About file permissions"
msgstr "عن صلاحيات الملفات"

#: src/umask.blp:128
msgid ""
"New files start with permission 666. A umask can remove permissions, but "
"cannot add execute permission."
msgstr ""
"تبدأ الملفات الجديدة بالصلاحية 666. يمكن لقناع المستخدم إزالة الصلاحيات، "
"لكنه لا يستطيع إضافة صلاحية التنفيذ."

#: src/umask.blp:153
msgid "New directories will be created with this permission"
msgstr "سيتم إنشاء المجلدات الجديدة بهذه الصلاحيات"

#: src/umask.blp:159 src/umask.blp:166
msgid "About directory permissions"
msgstr "عن صلاحيات المجلدات"

#: src/umask.blp:172
msgid ""
"New directories start with permission 777. A umask can remove read, write, "
"and execute permissions."
msgstr ""
"تبدأ المجلدات الجديدة بالصلاحية 777. يمكن لقناع المستخدم إزالة صلاحيات "
"القراءة والكتابة والتنفيذ."